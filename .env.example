# Client-side (used by the deployed app — safe to be public; RLS is the real
# access boundary, not secrecy of this key). Copy this file to .env.local for
# local dev, and set the same two as GitHub repo secrets for the deploy build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Migration-script-only (scripts/migrate/import.ts). NEVER commit real values,
# never expose the service role key to the deployed app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EXCEL_FILE_PATH=

# The 3 real family email addresses, in the same order as the sheet's person
# columns (C/D/E) — the migration script prints the resolved names/emails
# before writing anything, so double-check the order matches before running.
FAMILY_MEMBER_1_EMAIL=
FAMILY_MEMBER_2_EMAIL=
FAMILY_MEMBER_3_EMAIL=
